#!/bin/sh
# Synapse local pre-push gate (the project's CI replacement; #351 forbids GitHub
# Actions, so local gates are the automated backstop).
#
# Install once per clone:   git config core.hooksPath .githooks
#   `scripts/lint.ps1` reports when this is not done, so an unarmed clone is
#   visible rather than silent (#1931 ask 2).
# Bypass for a genuine emergency (e.g. a docs-only hotfix you cannot compile):
#   git push --no-verify
#   NOTE this is a bigger claim than it used to be. Since #1929/#1930 the gate
#   also covers RUSTSEC advisories, licence policy, wildcard dependencies and
#   lock-graph agreement, so --no-verify now skips a supply-chain check and not
#   only a lint pass.
#
# ---------------------------------------------------------------------------
# WHY THIS DELEGATES INSTEAD OF IMPLEMENTING THE GATES (#1931)
# ---------------------------------------------------------------------------
#
# This hook used to run `cargo fmt` and `cargo clippy` itself, per touched
# workspace. That made it a SECOND definition of "the gates", and it fell behind
# the first one twice without anyone noticing: #1928 added the clippy.toml and
# toolchain-pin agreement gates, then #1929/#1930 added lock-graph agreement and
# `cargo deny`, and this file knew about none of the four. A push could therefore
# introduce a RUSTSEC advisory, a disallowed licence, a wildcard dependency, a
# toolchain-pin split or a lock divergence and still be waved through by "the
# automated backstop".
#
# The root cause was the duplication, not any of the individual omissions, so the
# fix is to have exactly one definition. `scripts/lint.ps1` is it; this hook
# decides *whether* to run it and reports the result. Extending the gate set now
# reaches both entry points by construction.
#
# What stays here is the part that is genuinely hook-specific: deciding from the
# pushed ref range whether this push touches anything the gates can speak about,
# so a docs-only push is not charged a compile.
#
# COST NOTE: `scripts/lint.ps1` always covers BOTH workspaces, where this hook
# used to gate only the touched one. That is deliberate — the root workspace
# compiles calyx sources, so "only calyx changed" was never a reason to leave the
# root ungated — and with a warm target directory the untouched side is a
# no-op re-check rather than a rebuild.

set -e

# ---------------------------------------------------------------------------
# Scope — does this push touch anything the gates can speak about?
# ---------------------------------------------------------------------------
#
# Wider than "*.rs" on purpose. deny.toml, clippy.toml, rust-toolchain.toml, the
# lock files and the gate scripts themselves are all inputs to a gate, and a push
# that changes one of them while touching no Rust at all is exactly the push that
# most needs checking.
needs_gate=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleted branch (local_sha all zeros) — nothing to check.
  case "$local_sha" in *[!0]*) : ;; *) continue ;; esac
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ] || [ -z "$remote_sha" ]; then
    diff_base=$(git rev-list --max-parents=0 "$local_sha" | tail -1)
    range="$diff_base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  if ! changed_paths=$(git diff --name-only "$range"); then
    echo "pre-push: BLOCKED — failed to inspect pushed range '$range' for changed paths."
    exit 1
  fi

  if printf '%s\n' "$changed_paths" | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)(deny|clippy|rust-toolchain)\.toml$|^scripts/(lint|calyx-lock|install-cargo-deny)\.ps1$'; then
    needs_gate=1
  fi
done

if [ "$needs_gate" -eq 0 ]; then
  echo "pre-push: no Rust/Cargo/gate-config changes in this push — skipping the lint gate."
  exit 0
fi

# ---------------------------------------------------------------------------
# Delegate — and fail closed if the gate cannot be run
# ---------------------------------------------------------------------------
#
# An absent pwsh or an absent lint.ps1 must BLOCK. The whole subject of #1930 was
# a gate that reported success while checking nothing; a hook that shrugged and
# exited 0 because it could not find its own gate would be the same bug wearing
# a different hat.
repo_root=$(git rev-parse --show-toplevel)
lint_script="$repo_root/scripts/lint.ps1"

if [ ! -f "$lint_script" ]; then
  echo "pre-push: BLOCKED — $lint_script not found, so the gates cannot be run."
  echo "          This hook delegates to it and will not approve a push it did not check."
  exit 1
fi

if command -v pwsh >/dev/null 2>&1; then
  shell_bin=pwsh
elif command -v powershell >/dev/null 2>&1; then
  shell_bin=powershell
else
  echo "pre-push: BLOCKED — neither 'pwsh' nor 'powershell' is on PATH, so scripts/lint.ps1"
  echo "          cannot be run. Install PowerShell 7 (pwsh) or push with --no-verify only if"
  echo "          you have run the gates by hand and read the output."
  exit 1
fi

echo "pre-push: running the full gate set via scripts/lint.ps1 ($shell_bin) ..."
echo "pre-push:   1 clippy.toml contract   2 toolchain pin   3 lock-graph agreement"
echo "pre-push:   4 cargo fmt              5 cargo deny      6 cargo clippy"

# Capture the status from the command itself, NOT from after the `if`.
#
# This used to read `if "$shell_bin" ... ; then ... exit 0; fi` followed by
# `status=$?`. In POSIX sh an `if` with no `else` branch evaluates to 0 when its
# condition FAILS, so `$?` after the `fi` was 0 every time the gate failed. The
# hook then printed the self-contradicting "BLOCKED — scripts/lint.ps1 exited 0"
# and ran `exit 0`, letting the push through.
#
# So the backstop that #351 calls "the automated backstop" has been reporting
# failures while permitting them. Observed 2026-08-06: a real
# SYNAPSE_LINT_FMT_ROOT_FAILED printed BLOCKED and the push still landed on
# origin/main. A gate that announces it is blocking and then does not is worse
# than no gate, because the operator reads the word BLOCKED and believes it.
"$shell_bin" -NoProfile -File "$lint_script"
status=$?

if [ "$status" -eq 0 ]; then
  echo "pre-push: gate green — every gate passed in both workspaces."
  exit 0
fi
echo ""
echo "pre-push: BLOCKED — scripts/lint.ps1 exited $status. The failing gate, its error code"
echo "          and its remediation are printed above; lint.ps1 names all three and does not"
echo "          have a partial-success exit path."
echo "pre-push: re-run 'pwsh -File scripts/lint.ps1' to iterate, or 'git push --no-verify'"
echo "          only for a genuine emergency. Local gates are the automated backstop (#351)."
exit "$status"
