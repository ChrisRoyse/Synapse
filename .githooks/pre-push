#!/bin/sh
# Synapse local pre-push gate (the project's CI replacement; #351 forbids GitHub
# Actions, so "local cargo gates are source of truth"). Runs the deny-level clippy
# gate over the whole workspace before any push so [skip ci] branches can never
# push lint-red / non-compiling code — the exact class that slipped in via the
# #858 suggestion tests (clippy::field_reassign_with_default) and only surfaced at
# merge because those [skip ci] commits never ran clippy.
#
# Install once per clone:   git config core.hooksPath .githooks
# Bypass for a genuine emergency (e.g. a docs-only hotfix you cannot compile):
#   git push --no-verify   (use sparingly — you are skipping the only gate).
#
# Scope: D1 Gate 0 (no automated test surface) on every push, then rustfmt and
# clippy --workspace --all-targets -D warnings when Rust/Cargo files changed.
# The repo has no tests to run (D1). This hook is the structural compile+lint
# backstop, never a substitute for manual FSV.

set -e

# D1 Gate 0 (every push, including docs/script-only pushes): the repo carries
# ZERO automated tests (AGENTS.md D1, operator decision 2026-07-15). Scans the
# pushed commit's tree itself, not the working copy, for any test surface:
# test/bench paths, FSV driver files, #[test]/#[tokio::test]/#[cfg(test)], and
# [dev-dependencies]/[[test]]/[[bench]] manifest sections. The 2026-09-16
# pre-Calyx rollback (#2265) silently restored 396 test files because this gate
# had been rolled back with it.
d1_gate0() {
  sha="$1"
  bad_paths=$(git ls-tree -r --name-only "$sha" | grep -E '(^|/)(tests|benches)/|(^|/)tests\.rs$|_fsv_(driver|support)' || true)
  bad_src=$(git grep -n -E '#\[(tokio::)?test([( ]|\]|$)|#\[cfg\(test\)\]' "$sha" -- '*.rs' || true)
  bad_manifest=$(git grep -n -E '^\[(dev-dependencies|\[test\]|\[bench\])\]' "$sha" -- '*Cargo.toml' || true)
  if [ -n "$bad_paths$bad_src$bad_manifest" ]; then
    echo "pre-push: BLOCKED — D1 Gate 0: commit $sha carries an automated test surface."
    echo "          The repo carries ZERO automated tests (AGENTS.md D1). Remove these:"
    printf '%s\n' "$bad_paths" "$bad_src" "$bad_manifest" | grep -v '^$' | sed -n '1,60p'
    exit 1
  fi
}

# Skip the gate when the push contains no Rust / Cargo changes (docs, snapshots,
# tool-result logs): clippy would just burn a minute for nothing. Compare each
# pushed local sha against its remote counterpart from stdin.
needs_gate=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleted branch (local_sha all zeros) — nothing to check.
  case "$local_sha" in *[!0]*) : ;; *) continue ;; esac
  d1_gate0 "$local_sha"
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ] || [ -z "$remote_sha" ]; then
    range="$local_sha"            # new branch: inspect the whole commit
    diff_base=$(git rev-list --max-parents=0 "$local_sha" | tail -1)
    range="$diff_base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$'; then
    needs_gate=1
  fi
done

echo "pre-push: D1 Gate 0 green (no automated test surface)."

if [ "$needs_gate" -eq 0 ]; then
  echo "pre-push: no Rust/Cargo changes in this push — skipping clippy gate."
  exit 0
fi

log_dir=$(git rev-parse --git-path synapse-pre-push-logs 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")
mkdir -p "$log_dir"

# Formatting gate: the toolchain version is pinned in rust-toolchain.toml, and
# `cargo fmt` invoked here respects that pin, so this catches fmt drift (#1603)
# before it can be swept into an unrelated PR. --check makes no edits.
echo "pre-push: running local rustfmt gate (cargo fmt --all --check) ..."
fmt_log="$log_dir/fmt-$(date +%Y%m%dT%H%M%S)-$$.log"
if ! cargo fmt --all --check >"$fmt_log" 2>&1; then
  echo ""
  echo "pre-push: BLOCKED — rustfmt gate failed (workspace is not fmt-clean under"
  echo "          the pinned toolchain). Run 'cargo fmt --all' and re-push."
  echo "pre-push: diff follows (full log: $fmt_log):"
  sed -n '1,120p' "$fmt_log" || true
  exit 1
fi
rm -f "$fmt_log"
echo "pre-push: rustfmt gate green."

echo "pre-push: running local clippy gate (cargo clippy --workspace --all-targets -- -D warnings) ..."
log_path="$log_dir/clippy-$(date +%Y%m%dT%H%M%S)-$$.log"

if cargo clippy --workspace --all-targets -- -D warnings >"$log_path" 2>&1; then
  warning_count=$(grep -c '^warning:' "$log_path" 2>/dev/null || true)
  warning_count=${warning_count:-0}
  if [ "$warning_count" -gt 0 ]; then
    echo "pre-push: clippy gate green with ${warning_count} accepted warning lines; deny-level failures=0."
    echo "pre-push: full clippy log: $log_path"
  else
    rm -f "$log_path"
    echo "pre-push: clippy gate green (0 warnings)."
  fi
else
  status=$?
  echo ""
  echo "pre-push: BLOCKED — clippy gate failed. Full clippy log: $log_path"
  echo "pre-push: first 240 log lines follow:"
  sed -n '1,240p' "$log_path" || true
  total_lines=$(wc -l <"$log_path" 2>/dev/null | tr -d ' ' || true)
  total_lines=${total_lines:-0}
  if [ "$total_lines" -gt 240 ]; then
    echo "pre-push: output truncated; inspect the full log above for all diagnostics."
  fi
  echo ""
  echo "pre-push: BLOCKED — clippy gate failed. Fix the lint/build errors above, or"
  echo "          re-run with 'git push --no-verify' only if this is a genuine"
  echo "          non-compiling emergency. Local cargo gates are the source of truth (#351)."
  exit "$status"
fi
exit 0
